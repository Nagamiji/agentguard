  <main>
    <Hero />
    <hr class="rule container" />
    <Problem />
    <HowItWorks />
    <hr class="rule container" />
    <DeveloperWorkflow />
    <PolicyAsCode />
    <hr class="rule container" />
    <CICD />
    <SecurityArchitecture />
