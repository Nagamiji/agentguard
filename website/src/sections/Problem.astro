---
import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

import SectionHeader from '../components/SectionHeader.astro';
---

<section class="section" id="problem">
  <div class="container">
    <SectionHeader
      eyebrow="The problem"
      title="The words pass the review. The tool call is the danger."
      sub="A text-quality scorer reads the reply and sees a polite, helpful agent. It never sees the action underneath — the one that moves money, deletes data, or calls the wrong tool."
    />

    <div class="split">
      <article class="pane pane--prose" data-reveal>
        <div class="pane-head">
          <span class="pane-tag">What a text scorer sees</span>
          <span class="pane-verdict ok">looks fine ✓</span>
        </div>
        <div class="chat">
          <p class="msg user">Can you refund my order? It was $9,000.</p>
          <p class="msg bot">Certainly — I’ve processed the <strong>$9,000</strong> refund to your original payment method. Is there anything else I can help with?</p>
        </div>
        <p class="pane-note">Fluent. Polite. On-brand. And completely wrong.</p>
      </article>

      <div class="arrow" aria-hidden="true">
        <span class="arrow-line"></span>
        <span class="arrow-label">the action underneath</span>
        <span class="arrow-line"></span>
      </div>

      <article class="pane pane--call" data-reveal style="--reveal-delay: 120ms">
        <div class="pane-head">
          <span class="pane-tag">What AgentGuard checks</span>
          <span class="pane-verdict bad">blocked ✕</span>
        </div>
        <pre class="call scroll-x"><code><span class="c-fn">issue_refund</span>(<span class="c-arg">amount</span>=<span class="c-bad">9000</span>)
<span class="c-comment"># policy: issue_refund.amount ≤ 100</span>
<span class="c-comment"># verdict: BLOCKED — exceeds max allowed 100</span></code></pre>
        <p class="pane-note">AgentGuard judges the <strong>action</strong>, not the prose. The refund never ships.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--sp-6);
    align-items: stretch;
  }
  .pane {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-6);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }
  .pane--call { border-left: 2px solid var(--danger); }
  .pane-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .pane-tag { font-family: var(--font-mono); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); }
  .pane-verdict { font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 700; padding: 3px 8px; border-radius: 5px; }
  .pane-verdict.ok { color: var(--text-mut); background: var(--surface-2); }
  .pane-verdict.bad { color: var(--danger); background: var(--danger-dim); }

  .chat { display: flex; flex-direction: column; gap: var(--sp-3); flex: 1; }
  .msg { font-size: var(--fs-sm); padding: var(--sp-3) var(--sp-4); border-radius: var(--r-md); max-width: 90%; }
  .msg.user { align-self: flex-end; background: var(--surface-2); color: var(--text); border-bottom-right-radius: 4px; }
  /* Neutral, NOT green: this fluent reply is the dangerous one. Green is
     reserved for real ALLOWED verdicts (never decorative). */
  .msg.bot { align-self: flex-start; background: var(--surface-2); border: 1px solid var(--border); color: var(--text); border-bottom-left-radius: 4px; }
  .msg.bot strong { color: var(--text-hi); }

  .call { margin: 0; flex: 1; font-family: var(--font-mono); font-size: var(--fs-sm); line-height: 1.7; padding: var(--sp-4); background: var(--bg); border: 1px solid var(--border); border-radius: var(--r-sm); white-space: pre; }
  .c-fn { color: var(--code-key); }
  .c-arg { color: var(--text); }
  .c-bad { color: var(--danger); font-weight: 700; }
  .c-comment { color: var(--code-comment); }

  .pane-note { color: var(--text-mut); font-size: var(--fs-sm); }
  .pane-note strong { color: var(--text-hi); }

  .arrow { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--sp-2); color: var(--text-faint); }
  .arrow-line { width: 1px; flex: 1; background: linear-gradient(var(--border), transparent); min-height: 20px; }
  .arrow-label { font-family: var(--font-mono); font-size: var(--fs-xs); writing-mode: vertical-rl; text-orientation: mixed; letter-spacing: 0.04em; }

  @media (max-width: 820px) {
    .split { grid-template-columns: 1fr; }
    .arrow { flex-direction: row; }
    .arrow-line { width: auto; height: 1px; flex: 1; background: linear-gradient(90deg, var(--border), transparent); min-height: 0; }
    .arrow-label { writing-mode: horizontal-tb; }
  }
</style>
