---
import SectionHeader from '../components/SectionHeader.astro';
import PolicyCodeBlock from '../components/PolicyCodeBlock.astro';
import IntegrationCard from '../components/IntegrationCard.astro';
import { WORKFLOW_YML, INTEGRATIONS, SARIF } from '../data/product';
---

<section class="section" id="cicd">
  <div class="container">
    <SectionHeader
      eyebrow="CI/CD integration"
      title="One check in the pipeline you already have."
      sub="agentguard init writes the workflow for you. It runs on every push and pull request to main; findings land in the PR as SARIF, in GitHub’s native Code-Scanning tab."
    />

    <div class="cicd-grid">
      <div class="cicd-yaml" data-reveal>
        <PolicyCodeBlock code={WORKFLOW_YML} lang="yaml" filename=".github/workflows/agentguard.yml" />
      </div>

      <div class="cicd-side" data-reveal style="--reveal-delay: 100ms">
        <div class="sarif-card">
          <p class="sc-h">Findings as SARIF <span>{SARIF.version}</span></p>
          <ul class="sarif-map">
            {SARIF.levels.map((l) => (
              <li>
                <span class="sm-sev">{l.severity}</span>
                <span class="sm-arrow" aria-hidden="true">→</span>
                <code class="sm-level">{l.level}</code>
              </li>
            ))}
          </ul>
          <p class="sc-note">
            Emitted by tool <code>{SARIF.tool}</code>. GitHub renders each finding inline on the
            changed lines — reviewable in the PR, no extra console.
          </p>
        </div>
      </div>
    </div>

    <ul class="cards" data-reveal>
      {INTEGRATIONS.map((c) => (
        <li>
          <IntegrationCard title={c.title} blurb={c.blurb} href={c.href} icon={c.id as 'action' | 'sarif' | 'cli'} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cicd-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--sp-8); align-items: start; }
  .sarif-card { padding: var(--sp-6); background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--r-md); }
  .sc-h { font-size: var(--fs-md); color: var(--text-hi); font-weight: 600; margin-bottom: var(--sp-4); display: flex; align-items: baseline; gap: var(--sp-2); }
  .sc-h span { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--text-faint); }
  .sarif-map { list-style: none; padding: 0; margin: 0 0 var(--sp-4); display: grid; gap: var(--sp-3); }
  .sarif-map li { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--fs-sm); }
  .sm-sev { color: var(--text); min-width: 96px; }
  .sm-arrow { color: var(--text-faint); }
  .sm-level { font-family: var(--font-mono); color: var(--code-key); }
  .sc-note { color: var(--text-mut); font-size: var(--fs-sm); }
  .sc-note code { font-family: var(--font-mono); color: var(--text); font-size: 0.92em; }

  .cards { list-style: none; padding: 0; margin: var(--sp-8) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .cards > li { display: flex; }
  .cards > li > :global(*) { width: 100%; }

  @media (max-width: 860px) { .cicd-grid { grid-template-columns: 1fr; gap: var(--sp-8); } .cards { grid-template-columns: 1fr; } }
</style>
