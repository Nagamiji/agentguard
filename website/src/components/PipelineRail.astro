---
interface Step { id: string; title: string; detail?: string }
interface Props {
  steps: readonly Step[];
  variant?: 'full' | 'mini';
}
const { steps, variant = 'full' } = Astro.props;
---

<ol class:list={['rail', `v-${variant}`]} data-pipeline aria-label="How a scan runs">
  {steps.map((s, i) => (
    <li class="step" data-step>
      <div class="track">
        <span class="node"><span class="idx">{i + 1}</span></span>
        {i < steps.length - 1 && (
          <span class="conn" aria-hidden="true"><span class="conn-fill"></span></span>
        )}
      </div>
      <div class="meta">
        <p class="st-title">{s.title}</p>
        {variant === 'full' && s.detail && <p class="st-detail">{s.detail}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 4), 1fr);
    gap: var(--sp-4);
  }
  .step { display: flex; flex-direction: column; gap: var(--sp-4); min-width: 0; }
  .track { display: flex; align-items: center; gap: var(--sp-2); }

  .node {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-full);
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    color: var(--text-mut);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: color var(--dur-3) var(--ease-out), border-color var(--dur-3) var(--ease-out), background var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
  }
  .conn {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--border);
    border-radius: var(--r-full);
    overflow: hidden;
  }
  .conn-fill {
    position: absolute;
    inset: 0;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-4) var(--ease-out);
  }

  .st-title { color: var(--text-hi); font-weight: 600; font-size: var(--fs-base); }
  .st-detail { color: var(--text-mut); font-size: var(--fs-sm); margin-top: 4px; }

  /* Active state (motion.ts adds .is-active sequentially). Final state is
     default under reduced-motion (all steps active, no motion). */
  .step.is-active .node {
    color: var(--brand);
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 12%, var(--surface-1));
    box-shadow: 0 0 0 4px var(--brand-glow);
  }
  .step.is-active .conn-fill { transform: scaleX(1); }

  /* Mini variant (hero) — compact, single row, labels only. */
  .v-mini { gap: var(--sp-2); }
  .v-mini .node { width: 26px; height: 26px; font-size: var(--fs-xs); }
  .v-mini .st-title { font-size: var(--fs-xs); color: var(--text-mut); font-family: var(--font-mono); letter-spacing: 0.02em; }
  .v-mini .step { gap: var(--sp-2); }

  @media (max-width: 720px) {
    .rail:not(.v-mini) {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .rail:not(.v-mini) .step { flex-direction: row; align-items: flex-start; gap: var(--sp-4); padding-bottom: var(--sp-6); }
    .rail:not(.v-mini) .track { flex-direction: column; align-self: stretch; }
    .rail:not(.v-mini) .conn { width: 2px; height: auto; flex: 1; min-height: 24px; }
    .rail:not(.v-mini) .conn-fill { transform-origin: top center; transform: scaleY(0); }
    .rail:not(.v-mini) .step.is-active .conn-fill { transform: scaleY(1); }
    .rail:not(.v-mini) .meta { padding-top: 4px; }
  }
</style>
