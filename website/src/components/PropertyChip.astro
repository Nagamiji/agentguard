---
// A guarantee chip (fail-closed, deterministic, simulate-never-execute, ...).
interface Props {
  label: string;
  tone?: 'brand' | 'success' | 'info' | 'neutral';
}
const { label, tone = 'neutral' } = Astro.props;
---

<span class:list={['chip', `t-${tone}`]}>
  <span class="tick" aria-hidden="true">
    <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M3 8.5 6.5 12 13 4.5" />
    </svg>
  </span>
  {label}
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 6px 12px 6px 8px;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .tick { display: inline-grid; place-items: center; color: var(--brand); }
  .t-success .tick { color: var(--success); }
  .t-info .tick { color: var(--info); }
  .t-neutral .tick { color: var(--text-mut); }
  .chip:hover { border-color: var(--border-strong); }
</style>
