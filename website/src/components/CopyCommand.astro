---
// A copy-paste install command. The command is real, selectable text; the copy
// button is progressive enhancement (works without JS as a visible command).
interface Props {
  command: string;
  prompt?: string; // shell prompt glyph
  label?: string;
}
const { command, prompt = '$', label } = Astro.props;
---

<div class="copycmd">
  {label && <span class="cc-label">{label}</span>}
  <div class="cc-row">
    <code class="cc-code"><span class="cc-prompt" aria-hidden="true">{prompt}</span>{command}</code>
    <button class="cc-btn" type="button" data-copy={command} aria-label={`Copy: ${command}`}>
      <span class="cc-ico" aria-hidden="true">
        <svg aria-hidden="true" class="i-copy" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.6" />
          <path d="M3.5 10.5H3a1.5 1.5 0 0 1-1.5-1.5V3A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5" />
        </svg>
        <svg aria-hidden="true" class="i-check" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 8.5 6.5 12 13 4.5" />
        </svg>
      </span>
      <span class="cc-txt" data-copy-label>Copy</span>
    </button>
  </div>
</div>

<style>
  .copycmd { display: flex; flex-direction: column; gap: var(--sp-2); }
  .cc-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-mut);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cc-row {
    display: flex;
    align-items: stretch;
    gap: var(--sp-2);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 4px 4px 4px var(--sp-4);
    max-width: 100%;
  }
  .cc-code {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-hi);
    overflow-x: auto;
    white-space: nowrap;
    padding-block: var(--sp-2);
  }
  .cc-prompt { color: var(--text-faint); user-select: none; }
  .cc-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
    padding: 0 var(--sp-3);
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-mut);
    font-size: var(--fs-xs);
    font-weight: 600;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .cc-btn:hover { color: var(--text-hi); border-color: var(--border-strong); }
  .cc-ico { position: relative; display: inline-grid; width: 15px; height: 15px; }
  .cc-ico svg { position: absolute; inset: 0; transition: opacity var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out); }
  .i-check { opacity: 0; transform: scale(0.7); color: var(--success); }
  .cc-btn.is-copied .i-copy { opacity: 0; transform: scale(0.7); }
  .cc-btn.is-copied .i-check { opacity: 1; transform: scale(1); }
  .cc-btn.is-copied { color: var(--success); border-color: color-mix(in srgb, var(--success) 30%, transparent); }
</style>
