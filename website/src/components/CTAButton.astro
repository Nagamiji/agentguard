---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  external?: boolean;
  size?: 'md' | 'lg';
}
const { href, variant = 'primary', external = false, size = 'md' } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  href={href}
  class:list={['btn', `v-${variant}`, `s-${size}`]}
  {...rel ? { rel } : {}}
  {...target ? { target } : {}}
>
  <span class="btn-label"><slot /></span>
  {external && <span class="ext" aria-hidden="true">↗</span>}
</a>

<style>
  .btn {
    --_bg: transparent;
    --_fg: var(--text-hi);
    --_bd: var(--border-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 0 var(--sp-4);
    height: 42px;
    border-radius: var(--r-sm);
    border: 1px solid var(--_bd);
    background: var(--_bg);
    color: var(--_fg);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-sm);
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      transform var(--dur-1) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .s-lg { height: 48px; padding-inline: var(--sp-6); font-size: var(--fs-base); }

  .v-primary {
    --_bg: var(--brand);
    --_fg: var(--brand-ink);
    --_bd: transparent;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.14) inset, 0 6px 20px var(--brand-glow);
  }
  .v-primary:hover {
    --_bg: var(--brand-hi);
    color: var(--brand-ink);
    transform: translateY(-1px);
  }
  .v-secondary { --_bg: var(--surface-2); --_fg: var(--text-hi); --_bd: var(--border); }
  .v-secondary:hover { --_bd: var(--border-strong); transform: translateY(-1px); color: var(--text-hi); }
  .v-ghost { --_bd: transparent; --_fg: var(--text); }
  .v-ghost:hover { --_fg: var(--text-hi); --_bd: var(--border); }

  .btn:active { transform: translateY(0); }
  .ext { font-size: 0.85em; opacity: 0.8; }
</style>
